# =============================================================================
# {{name}} ({{iso3}}) - currency basket regimes
# Generated by the EMDE website build on {{date}}. Self-contained: needs only
# {{iso3}}_fx_data.csv (in the same folder) and the packages below.
# Rates in the CSV are expressed in units of {{numeraire}}.
# =============================================================================

for (p in c("zoo", "fxregime")) {
  if (!requireNamespace(p, quietly = TRUE)) install.packages(p, repos = "https://cloud.r-project.org")
}
library(zoo)
library(fxregime)

# ---- model code (identical for every country) -------------------------------
{{fit_code}}

# ---- run --------------------------------------------------------------------
fx  <- read.csv("{{iso3}}_fx_data.csv")
res <- fit_country(
  fx,
  ccy        = "{{ccy}}",
  regressors = c({{regressors}}),
  h          = {{h}},
  breaks     = {{breaks}},
  ic         = "{{ic}}",
  frequency  = "{{frequency}}"
)

print(res$break_dates)
print(res$regimes)
write.csv(res$regimes, "{{iso3}}_regimes.csv", row.names = FALSE)
